# Kopieer dit bestand naar ".env" en vul de echte waarden in.
# ".env" wordt NIET meegecommit naar git (staat in .gitignore).

# SMTP-gegevens van je e-mailservice (bv. Brevo, Resend, Mailgun) waarmee het
# contactformulier mails verstuurt. Gebruik geen wachtwoord van je eigen
# Outlook-account hiervoor, maar een losse SMTP API-key/app-wachtwoord van de
# gekozen dienst.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=jouw-smtp-gebruikersnaam
SMTP_PASSWORD=jouw-smtp-wachtwoord-of-api-key

# Het afzenderadres dat de ontvanger (Outlook) te zien krijgt. Moet meestal
# een adres/domein zijn dat bij je SMTP-account hoort.
SMTP_FROM=website@kolkie.nl

# Het adres waar contactformulier-berichten naartoe gestuurd worden.
CONTACT_TO_EMAIL=lucasrensen@outlook.com
