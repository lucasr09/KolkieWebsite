# Kopieer dit bestand naar ".env" en vul 'm in met echte SMTP-gegevens.
# ".env" zelf staat in .gitignore en hoort NOOIT in git te komen.

# SMTP-gegevens van je transactional e-mail service (bv. Brevo, Resend, Mailgun).
# Gebruik geen wachtwoord van een gewoon Outlook/Gmail-account hiervoor.
SMTP_HOST=smtp.jouw-provider.example
SMTP_PORT=587
SMTP_USERNAME=jouw-smtp-gebruikersnaam
SMTP_PASSWORD=jouw-smtp-wachtwoord

# Afzender-adres dat de ontvanger te zien krijgt (moet meestal geverifieerd
# zijn bij je e-mailprovider).
SMTP_FROM=noreply@jouwdomein.example

# Waar het contactformulier naartoe mailt. Optioneel: valt terug op
# lucasrensen@outlook.com als dit niet is ingesteld.
CONTACT_TO_EMAIL=lucasrensen@outlook.com
